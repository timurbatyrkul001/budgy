rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── yardımcılar ────────────────────────────────────────────────────
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function data() {
      return request.resource.data;
    }

    // Tutarlar her zaman pozitif sayı olmalı. Negatif/NaN/metin bir tutar,
    // bakiyeleri sessizce bozar; kural katmanı son savunma hattı.
    function validAmount(value) {
      return value is number && value > 0 && value < 1000000000;
    }

    // ── kullanıcı verisi ───────────────────────────────────────────────
    // Каждый пользователь читает и пишет только свои данные.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /envelopes/{envelopeId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && data().name is string
          && data().name.size() > 0
          && data().name.size() <= 60
          && data().balance is number
          && (!('targetAmount' in data())
              || data().targetAmount == null
              || data().targetAmount is number);
      }

      match /transactions/{txId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && data().type in ['income', 'expense', 'transfer']
          && validAmount(data().amount)
          && data().date is timestamp;
        // Düzenleme (updateTx): tür/tutar/tarih/kategori değişebilir;
        // yeni değerler de oluşturma kurallarına uymalı.
        allow update: if isOwner(uid)
          && data().type in ['income', 'expense', 'transfer']
          && validAmount(data().amount)
          && data().date is timestamp;
      }

      // Cüzdan hesapları: users/{uid}/accounts/{accountId} — şimdilik tek
      // belge (`cash`), ileride banka/kart hesapları aynı bloğa girer.
      //
      // DİKKAT: üstteki `match /users/{uid}` izni alt koleksiyonlara İNMEZ;
      // her alt koleksiyonun kendi bloğu olmak zorunda. Bu blok eksikken
      // cüzdana yazan HER İŞLEM sessizce reddediliyordu — gün kaydetme,
      // harcama, gelir, hepsi (batch atomik olduğu için gün belgesi de
      // beraberinde geri alınıyordu).
      //
      // Bakiye NEGATİF olabilir (eksiye düşen kasa), o yüzden validAmount
      // değil düz sayı kontrolü. Silme açık: "hesabımı sil" akışı
      // (deleteAccountData) bu belgeleri de temizlemek zorunda.
      match /accounts/{accountId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && data().balance is number;
      }

      // Çalışma günleri, hatırlatıcılar ve ayarlar: sahiplik kontrolü yeterli.
      match /workDays/{dayId} {
        allow read, write: if isOwner(uid);
      }

      match /reminders/{reminderId} {
        allow read, write: if isOwner(uid);
      }

      // Tekrarlayan işlem kuralları: tutar pozitif, tür geçerli.
      match /recurring/{ruleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && data().type in ['income', 'expense']
          && validAmount(data().amount)
          && data().nextDate is timestamp;
      }

      match /settings/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Kategori otomasyonu: kullanıcı kuralları (anahtar kelime → zarf).
      match /rules/{ruleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && data().keyword is string
          && data().keyword.size() > 0
          && data().keyword.size() <= 60
          && data().envelopeId is string;
      }
    }
  }
}
